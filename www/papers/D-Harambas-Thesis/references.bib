@book{penkov2007tensorrepresentationsclassicallocally,
author="Penkov, I.
and Styrkas, K.",
editor="Neeb, Karl-Hermann
and Pianzola, Arturo",
title="Tensor Representations of Classical Locally Finite Lie Algebras",
series="Developments and Trends in Infinite-Dimensional Lie Theory",
year="2011",
publisher="Birkh{\"a}user Boston",
abstract="The structure of tensor representations of the classical finite-dimensional Lie algebras was described by H. Weyl.In this paper we extend Weyl's results to the classical infinite-dimensional locally finite Lie algebras {\$}{\$}{\{}{\backslash}mathfrak{\{}g{\}}{\{}{\{}{\backslash}mathfrak{\{}l{\}}{\}}{\}}{\_}{\{}{\backslash}infty{\}}{\}},{\backslash},{\backslash},{\{}{\backslash}mathfrak{\{}s{\}}{\{}{\{}{\backslash}mathfrak{\{}{\{}l{\}}{\}}{\}}{\_}{\{}{\backslash}infty{\}}{\}}{\}},{\backslash},{\backslash},{\{}{\backslash}mathfrak{\{}s{\}}{\{}{\{}{\backslash}mathfrak{\{}{\{}p{\}}{\}}{\}}{\_}{\{}{\backslash}infty{\}}{\}}{\}}{\backslash},{\backslash},{\backslash},{\{}{\backslash}rm and{\}}{\backslash},{\backslash},{\backslash}, {\{}{\backslash}mathfrak{\{}s{\}}{\{}{\{}{\backslash}mathfrak{\{}{\{}o{\}}{\}}{\}}{\_}{\{}{\backslash}infty{\}}{\}}{\}},{\$}{\$}and study important new features specific to the infinite-dimensional setting. Let {\$}{\$}{\backslash}mathfrak{\{}g{\}}{\$}{\$}be one of the above locally finite Lie algebras and let v be the natural representation of {\$}{\$}{\backslash}mathfrak{\{}g{\}}.{\$}{\$}The tensor representations of {\$}{\$}{\backslash}mathfrak{\{}g{\}}.{\$}{\$}have the form V⊗p ⊗ V⊗q* for the cases {\$}{\$}{\{}{\backslash}mathfrak{\{}g{\}}{\}}={\backslash},{\backslash},{\{}{\backslash}mathfrak{\{}g{\}}{\}}{\{}{\{}{\backslash}mathfrak{\{}{\{}l{\}}{\}}{\}}{\}}{\_}{\{}{\backslash}infty{\}},{\backslash},{\backslash},{\{}{\backslash}mathfrak{\{}s{\}}{\{}{\{}{\backslash}mathfrak{\{}{\{}l{\}}{\}}{\}}{\_}{\{}{\backslash}infty{\}}{\}}{\}},{\$}{\$}where V* is the restricted dual ofV. In contrast with the finite-dimensional case, these tensorrepresentations are not semisimple. We explicitly describe their Jordan'H{\"o}llder constituents, socle filtrations, and indecomposable direct summands.",
isbn="978-0-8176-4741-4",
doi="10.1007/978-0-8176-4741-4_4",
url="https://doi.org/10.1007/978-0-8176-4741-4_4",
note = {pp. 127-150}
}


