\def\makeAutonum{%
\global\mymatrixLnotestrue
\global\mymatrixTnotestrue
\global\mymatrixCcnt=0\relax
\global\edef\mymatrixTnoteslist{}%
\Aloop\global\advance\mymatrixCcnt by 1\relax
\global\edef\mymatrixTnoteslist{\mymatrixTnoteslist!\number\mymatrixCcnt!\number\mymatrixCcnt;}%
\ifnum\mymatrixCcnt>\mymatrixAcnt\else\Arepeat
\global\mymatrixDcnt=0\relax
\global\edef\mymatrixLnoteslist{}%
\Aloop\global\advance\mymatrixDcnt by 1\relax
\global\edef\mymatrixLnoteslist{\mymatrixLnoteslist!\number\mymatrixDcnt!\number\mymatrixDcnt;}%
\ifnum\mymatrixDcnt>\mymatrixBcnt\else\Arepeat
}

