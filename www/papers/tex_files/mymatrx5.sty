\def\process##1{\global\advance\mymatrixBcnt by 1\relax
\global\mymatrixTnote{}\global\mymatrixLnote{}%
\global\mymatrixBnote{}\global\mymatrixRnote{}%
\setbox0\hbox{\hskip\mymatrixhsep${##1}\mathstrut$\hskip\mymatrixhsep}%
\mymatrixtop=\ht0\advance\mymatrixtop by \mymatrixvsep\ht0=\mymatrixtop
\mymatrixtop=\dp0\advance\mymatrixtop by \mymatrixvsep\dp0=\mymatrixtop
\global\edef\mymatrixwdlist{\mymatrixwdlist!\number\mymatrixAcnt,\number\mymatrixBcnt!\the\wd0;}%
\global\edef\mymatrixhtlist{\mymatrixhtlist!\number\mymatrixAcnt,\number\mymatrixBcnt!\the\ht0;}%
\global\edef\mymatrixdplist{\mymatrixdplist!\number\mymatrixAcnt,\number\mymatrixBcnt!\the\dp0;}%
\edef\test{\the\mymatrixTnote}\ifx\test\empty\else\global\mymatrixTnotestrue\fi
\global\edef\mymatrixTnoteslist{\mymatrixTnoteslist!\number\mymatrixBcnt!\the\mymatrixTnote;}%
\edef\test{\the\mymatrixBnote}\ifx\test\empty\else\global\mymatrixBnotestrue\fi
\global\edef\mymatrixBnoteslist{\mymatrixBnoteslist!\number\mymatrixBcnt!\the\mymatrixBnote;}%
\edef\test{\the\mymatrixLnote}\ifx\test\empty\else\global\mymatrixLnotestrue\fi
\global\edef\mymatrixLnoteslist{\mymatrixLnoteslist!\number\mymatrixAcnt!\the\mymatrixLnote;}%
\edef\test{\the\mymatrixRnote}\ifx\test\empty\else\global\mymatrixRnotestrue\fi
\global\edef\mymatrixRnoteslist{\mymatrixRnoteslist!\number\mymatrixAcnt!\the\mymatrixRnote;}%
}%
