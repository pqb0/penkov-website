\ifdim\mymatrixtmpdim>\mymatrixlft\mymatrixlft=\mymatrixtmpdim\fi
\advance\mymatrixCcnt by 1\relax\ifnum\mymatrixCcnt>\mymatrixAcnt\else\Brepeat
\global\edef\mymatrixWDlist{\mymatrixWDlist!\number\mymatrixDcnt!\the\mymatrixlft;}%
\advance\mymatrixDcnt by 1\relax\ifnum\mymatrixDcnt>\mymatrixBcnt\else\Arepeat
\mymatrixCcnt=1\relax
\Aloop
\mymatrixtop=0pt\relax
\mymatrixbot=0pt\relax
\mymatrixDcnt=1\relax
\Bloop
\edef\tmp{(\number\mymatrixCcnt,\number\mymatrixDcnt)}%
\expandafter\mymatrixHT\tmp
\ifdim\mymatrixtmpdim>\mymatrixtop\mymatrixtop=\mymatrixtmpdim\fi
\edef\tmp{(\number\mymatrixCcnt,\number\mymatrixDcnt)}%
\expandafter\mymatrixDP\tmp
\ifdim\mymatrixtmpdim>\mymatrixbot\mymatrixbot=\mymatrixtmpdim\fi
\advance\mymatrixDcnt by 1\relax\ifnum\mymatrixDcnt>\mymatrixBcnt\else\Brepeat
\global\edef\mymatrixHTlist{\mymatrixHTlist!\number\mymatrixCcnt!\the\mymatrixtop;}%
\global\edef\mymatrixDPlist{\mymatrixDPlist!\number\mymatrixCcnt!\the\mymatrixbot;}%
\advance\mymatrixCcnt by 1\relax\ifnum\mymatrixCcnt>\mymatrixAcnt\else\Arepeat
\setbox\mymatrixAbox\vbox{
\ifx\matrixsize\undefined\else\matrixsize\fi\offinterlineskip
\offinterlineskip
\def\process##1{\global\advance\mymatrixBcnt by 1\relax
\edef\tmp{(\number\mymatrixAcnt,\number\mymatrixBcnt)}%
\expandafter\mymatrixgetsizes\tmp%
\mymatrixtop=0pt\mymatrixbot=0pt
\mymatrixlft=0pt\mymatrixrt=0pt
\ifLines\fbox\fi
\setbox0\hbox to \mymatrixcellwd{\hss$##1$\hss}%
\ht0=\mymatrixcellht\dp0=\mymatrixcelldp
\setbox0\hbox{\hbox to 0pt{\hss\vrule width \mymatrixlft
height \mymatrixcellht depth \mymatrixcelldp\hss}%
\raise\mymatrixcellht\rlap{\kern-.5\mymatrixlft\vrule width .5\mymatrixlft
\vrule width \mymatrixcellwd height .5\mymatrixtop depth .5\mymatrixtop
\vrule width .5\mymatrixrt}%
\lower\mymatrixcelldp\rlap{\kern-.5\mymatrixlft\vrule width .5\mymatrixlft
\vrule width \mymatrixcellwd height .5\mymatrixbot depth .5\mymatrixbot
\vrule width .5\mymatrixrt}%
\box0\hbox to 0pt{\hss\vrule width \mymatrixrt
height \mymatrixcellht depth \mymatrixcelldp\hss}}%
\ht0=\mymatrixcellht\dp0=\mymatrixcelldp\relax\box0\relax}%
\global\mymatrixAcnt=0\relax
\halign{%
\global\advance\mymatrixAcnt by 1\relax
\global\mymatrixBcnt=0\relax
\process{##}&&\process{##}\crcr #3}}%
\setbox\mymatrixBbox\vbox{
\ifx\matrixsize\undefined\else\matrixsize\fi\offinterlineskip
\offinterlineskip
\def\process##1{\global\advance\mymatrixBcnt by 1\relax
\edef\tmp{(\number\mymatrixAcnt,\number\mymatrixBcnt)}%
\expandafter\mymatrixgetsizes\tmp\global\mymatrixgrayfalse
\setbox0\hbox{$##1$}\ifmymatrixgray\special{ps:gsave .8 setgray}\vrule
width \mymatrixcellwd height \mymatrixcellht depth \mymatrixcelldp
\special{ps:grestore}\else\vrule width 0pt height \mymatrixcellht
depth \mymatrixcelldp\kern\mymatrixcellwd\fi}%
\global\mymatrixAcnt=0\relax
\halign{%
\global\advance\mymatrixAcnt by 1\relax
\global\mymatrixBcnt=0\relax
\process{##}&&\process{##}\crcr #3}}%
\ifmymatrixTnotes\mymatrixMakeCbox\fi
\ifmymatrixBnotes\mymatrixMakeFbox\fi
\ifmymatrixTnotes\mymatrixMakeCbox\fi
\ifmymatrixLnotes\mymatrixMakeDbox\setbox\mymatrixDbox
\hbox{$\vcenter{\offinterlineskip\hbox{\box\mymatrixDbox}}$}\fi
\ifmymatrixRnotes\mymatrixMakeEbox\setbox\mymatrixEbox
\hbox{$\vcenter{\offinterlineskip\hbox{\box\mymatrixEbox}}$}\fi
\setbox0\hbox{\rlap{\box\mymatrixBbox}\box\mymatrixAbox}%
\setbox1\hbox{\ensuremath{\vcenter{\copy0}}}%
\mymatrixcellht=\ht1\relax\mymatrixcelldp=\dp1\relax
\setbox\mymatrixAbox\hbox{$\left#1\vcenter{\kern-\mymatrixvsep\box0\kern-\mymatrixvsep}\right#2$}%
\ifmymatrixTnotes\ht\mymatrixAbox=\mymatrixcellht\fi
\ifmymatrixBnotes\dp\mymatrixAbox=\mymatrixcelldp\fi
%\copy\mymatrixEbox
%\copy\mymatrixAbox
\hbox{\ifmymatrixLnotes\kern\mymatrixhsep\box\mymatrixDbox\kern\mymatrixhsep\fi
\vtop{\offinterlineskip
  \halign{\hfil ##\hfil\cr
  \vbox{\offinterlineskip
    \halign{\hfil ##\hfil\cr
    \ifmymatrixTnotes\box\mymatrixCbox\fi\cr
    \noalign{\ifmymatrixTnotes\vskip\mymatrixvsep\vskip2pt\fi}%
    \box\mymatrixAbox\cr}}\cr
  \noalign{\ifmymatrixBnotes\vskip\mymatrixvsep\vskip2pt\fi}%
  \hfill\ifmymatrixBnotes\box\mymatrixFbox\fi\hfill
