\global\edef\mymatrixWDlist{}%
\global\edef\mymatrixHTlist{}%
\global\edef\mymatrixDPlist{}%
\mymatrixDcnt=1\relax
\Aloop
\mymatrixlft=0pt\relax
\mymatrixCcnt=1\relax
\Bloop
\edef\tmp{(\number\mymatrixCcnt,\number\mymatrixDcnt)}%
