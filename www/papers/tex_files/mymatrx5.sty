  \rlap{\kern\mymatrixhsep\hbox to \mymatrixlrtNotewd
  {\hss\copy\mymatrixlrtNotebox\hss}}\fi\cr}}%
\ifmymatrixRnotes\kern\mymatrixhsep\box\mymatrixEbox\kern\mymatrixhsep\fi
\ifdim\mymatrixlrtNotewd>0pt\kern.5\wd\mymatrixlrtNotebox
\kern-.5\mymatrixlrtNotewd
\global\setbox\mymatrixlrtNotebox\copy\voidb@x
\global\mymatrixlrtNotewd=0pt\fi
}}}

\def\Makeemptylist{\edef\emptylist{}%
\mymatrixCcnt=1\relax\Aloop
\mymatrixDcnt=1\relax\Bloop
\edef\emptylist{\emptylist!\number\mymatrixCcnt,\number\mymatrixDcnt!0pt;}%
\advance\mymatrixDcnt by 1\relax
\ifnum\mymatrixDcnt>\mymatrixBcnt\else\Brepeat
\advance\mymatrixCcnt by 1\relax
\ifnum\mymatrixCcnt>\mymatrixAcnt\else\Arepeat
}

\def\mymatrixMakeCbox{%\show\mymatrixTnoteslist%
\setbox\mymatrixCbox\hbox{\global\mymatrixCcnt=1\relax\Aloop
\edef\tmp{(1,\number\mymatrixCcnt)}\expandafter\mymatrixgetsizes\tmp%
\edef\tmp{(\number\mymatrixCcnt)}\expandafter\mymatrixTN\tmp%
\hbox to \mymatrixcellwd{\hss\matrixnotesize
\ifx\Tnotesize\undefined\else\Tnotesize\fi\the\mymatrixTnote\hss}%
\global\advance\mymatrixCcnt by 1\relax
\ifnum\mymatrixCcnt>\mymatrixBcnt\else\Arepeat}}

\def\mymatrixMakeFbox{%\show\mymatrixBnoteslist%
\setbox\mymatrixFbox\hbox{\global\mymatrixCcnt=1\relax\Aloop
\edef\tmp{(1,\number\mymatrixCcnt)}\expandafter\mymatrixgetsizes\tmp%
\edef\tmp{(\number\mymatrixCcnt)}\expandafter\mymatrixBN\tmp%
\hbox to \mymatrixcellwd{\hss\matrixnotesize
\ifx\Bnotesize\undefined\else\Bnotesize\fi\the\mymatrixBnote\hss}%
\global\advance\mymatrixCcnt by 1\relax
\ifnum\mymatrixCcnt>\mymatrixBcnt\else\Arepeat}}

\def\mymatrixMakeDbox{%\show\mymatrixLnoteslist%
\setbox\mymatrixDbox\vbox{\global\mymatrixCcnt=1\relax\offinterlineskip\Aloop
\edef\tmp{(\number\mymatrixCcnt,1)}\expandafter\mymatrixgetsizes\tmp%
\edef\tmp{(\number\mymatrixCcnt)}\expandafter\mymatrixLN\tmp%
\hbox{\matrixnotesize
\ifx\Lnotesize\undefined\else\Lnotesize\fi
\the\mymatrixLnote\vrule width 0pt height \mymatrixcellht
depth \mymatrixcelldp}%
\global\advance\mymatrixCcnt by 1\relax
\ifnum\mymatrixCcnt>\mymatrixAcnt\else\Arepeat}}

\def\mymatrixMakeEbox{%\show\mymatrixRnoteslist%
\setbox\mymatrixEbox\vbox{\global\mymatrixCcnt=1\relax\offinterlineskip\Aloop
\edef\tmp{(\number\mymatrixCcnt,1)}\expandafter\mymatrixgetsizes\tmp%
\edef\tmp{(\number\mymatrixCcnt)}\expandafter\mymatrixRN\tmp%
\hbox{\matrixnotesize
\ifx\Rnotesize\undefined\else\Rnotesize\fi
\the\mymatrixRnote\vrule width 0pt height \mymatrixcellht
depth \mymatrixcelldp}%
\global\advance\mymatrixCcnt by 1\relax
\ifnum\mymatrixCcnt>\mymatrixAcnt\else\Arepeat}}

\def\Aloop#1\Arepeat{\def\Aiterate{#1\relax\expandafter\Aiterate\fi}\Aiterate\let\Aiterate\relax}
\def\Bloop#1\Brepeat{\def\Biterate{#1\relax\expandafter\Biterate\fi}\Biterate\let\Biterate\relax}

\def\mymatrixTN(#1){\def\tmp##1!#1!##2;##3\endlist{\mymatrixTnote={##2}\relax}%
\expandafter\tmp\mymatrixTnoteslist\endlist}
\def\mymatrixBN(#1){\def\tmp##1!#1!##2;##3\endlist{\mymatrixBnote={##2}\relax}%
\expandafter\tmp\mymatrixBnoteslist\endlist}
\def\mymatrixRN(#1){\def\tmp##1!#1!##2;##3\endlist{\mymatrixRnote={##2}\relax}%
\expandafter\tmp\mymatrixRnoteslist\endlist}
\def\mymatrixLN(#1){\def\tmp##1!#1!##2;##3\endlist{\mymatrixLnote={##2}\relax}%
\expandafter\tmp\mymatrixLnoteslist\endlist}
\def\mymatrixWD(#1,#2){\def\tmp##1!#1,#2!##2;##3\endlist{\mymatrixtmpdim=##2\relax}%
\expandafter\tmp\mymatrixwdlist\endlist}
\def\mymatrixHT(#1,#2){\def\tmp##1!#1,#2!##2;##3\endlist{\mymatrixtmpdim=##2\relax}%
\expandafter\tmp\mymatrixhtlist\endlist}
\def\mymatrixDP(#1,#2){\def\tmp##1!#1,#2!##2;##3\endlist{\mymatrixtmpdim=##2\relax}%
\expandafter\tmp\mymatrixdplist\endlist}
\def\mymatrixgetsizes(#1,#2){%
\def\tmp##1!#2!##2;##3\endlist{\mymatrixcellwd=##2\relax}\expandafter\tmp\mymatrixWDlist\endlist
\def\tmp##1!#1!##2;##3\endlist{\mymatrixcellht=##2\relax}\expandafter\tmp\mymatrixHTlist\endlist
\def\tmp##1!#1!##2;##3\endlist{\mymatrixcelldp=##2\relax}\expandafter\tmp\mymatrixDPlist\endlist
}

